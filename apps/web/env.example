# @kite/web — env NAMES + non-secret defaults only (T003).
# Copy to `apps/web/.env` (gitignored). Secrets never enter code, prompts, or
# git — a missing variable aborts by NAME only. VITE_* names are public by
# design: they are baked into the browser bundle and carry no secret.

# Base URL of the @kite/api service (005's surface + 006's verification routes).
VITE_API_URL=http://localhost:3000

# Public Monad RPC for direct read-only calls (007 T006: offerOf/isaOf/
# balanceOf alongside the API). Non-secret by design — every VITE_* value is
# baked into the browser bundle.
VITE_RPC_URL=https://testnet-rpc.monad.xyz

# Mitra-console-only demo credential (007 T033): testnet, operator-held env —
# NEVER the INTERNAL key, never committed with a value. Leave empty unless you
# are building the operator's console bundle.
VITE_MITA_KEY=
