# Kite — deployment + seed environment (Feature 004)
#
# Copy to `.env` (gitignored) and fill. This file carries NAMES and non-secret
# DEFAULTS only — never commit values (spec FR-005; secrets gate = quickstart §7).
# Every script aborts naming a missing variable (`EnvMissing(<NAME>)`), never
# printing one.
#
# Chain guard: scripts revert unless block.chainid == 10143 (Monad testnet).

# ── Chain ────────────────────────────────────────────────────────────────
# Monad testnet RPC (default https://testnet-rpc.monad.xyz; Foundation
# https://rpc-testnet.monadinfra.com works too but rejects batches).
# RPC_URL=https://testnet-rpc.monad.xyz

# ── Operators (keys are secrets — fund all via https://faucet.monad.xyz) ──
# Deployer: broadcasts deployment + seed funding leg; needs >= 0.5 MON.
# DEPLOYER_KEY=
# RELAYER_KEY=            # grants nothing; RELAYER_ROLE is granted TO its address
# ORCHESTRATOR_KEY=       # same: ORCHESTRATOR_ROLE lands on this address
# Optional ADDR mirrors when a wallet is watch-only (address read from the key otherwise)
# RELAYER_ADDR=
# ORCHESTRATOR_ADDR=

# ── Role holders without keys this feature ──────────────────────────────
# PAUSER_ADDR=            # receives PAUSER_ROLE at init
# ADMIN_ADDR=             # receives ADMIN/default-admin at init; defaults to deployer

# ── Personas (seed only — keys are secrets) ─────────────────────────────
# BUDI_KEY=               # seeker (all three ISAs)
# SITI_KEY=               # historical backer A (ISA-1)
# WATI_KEY=               # historical backer B (ISA-2)
# PAKHAJI_KEY=            # active backer (demo ISA-3)
# MILL_KEY=               # channel signer AND funding account of every income gross

# ── Channel ─────────────────────────────────────────────────────────────
# MILL_CHANNEL_NAME=      # registered via registerChannel(1, <name>, mill-address)

# ── Live deployment pointer (seed + runbook helpers) ────────────────────
# The ERC-1967 proxy address — THE Kite address for all consumers (copy it
# from the deploy manifest / DEMO-ACCOUNTS.md). Required by SeedDemo,
# SignPermit, SignIncome; the settlement asset itself is read from the
# contract (`kite.ausd()`), never from env.
# KITE_CORE_ADDRESS=

# ── Asset switch (Q2/C) ─────────────────────────────────────────────────
# Unset -> MockAUSD is deployed (1,000,000 AUSD minted to deployer).
# Set    -> attach to that address, ONLY after the preflight passes:
#           code exists, decimals == 6, deployer balance >= SEED_AUSD_MIN.
# AUSD_ADDRESS=

# ── Explorer verification (optional) ────────────────────────────────────
# Monadscan (Etherscan-compatible) may accept a placeholder; set a real key if
# verification demands one. Never commit it.
# EXPLORER_API_KEY=

# ── Seed tuning (non-secret defaults) ───────────────────────────────────
# Compressed qualifying gap for the DEMO deployment (protocol value: 60 days —
# disclosed per FR-018/PLAN §6.2). Driver sleeps gap+10s before each qualifying
# event after the first (4 sleeps ≈ 5 min at 60).
# DEMO_GAP_SECONDS=60
# Deployer AUSD balance required when attaching a real asset (seed 7,350 +
# finale headroom + throwaway loop).
# SEED_AUSD_MIN=14000000000
# MON top-ups from deployer during the seed funding leg.
# MON_TOPUP_OPERATOR=1000000000000000000
# MON_TOPUP_PERSONA=300000000000000000
