# Keep the Fly build context tiny — the repo root is the context (see
# apps/api/Dockerfile), and contracts/lib alone is ~200 MB of Foundry trees
# the API image never needs.
.git
node_modules
**/node_modules
**/dist
contracts
!contracts/script/DEMO-ACCOUNTS.md
specs
apps/web
apps/relayer
packages/envio
.specify
.claude
.env
.env.*
*.log
bun.lock.bak
