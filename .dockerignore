# Keep the Fly build context tiny — the repo root is the context (see
# apps/api/Dockerfile + apps/relayer/Dockerfile), and contracts/lib alone is
# ~200 MB of Foundry trees neither image ever needs.
.git
node_modules
**/node_modules
**/dist
contracts
!contracts/script/DEMO-ACCOUNTS.md
specs
apps/web
packages/envio
.specify
.claude
.env
.env.*
*.log
bun.lock.bak
