{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Kite Next.js — extends base",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2022"],
    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  }
}
