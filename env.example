# Kite backend (Feature 005) — env NAMES + non-secret defaults only.
# Copy to `.env` (gitignored) and fill the values. Secrets never enter code,
# prompts, or git — a missing variable aborts as EnvMissing(<NAME>), nothing more.

# --- Database (Neon Postgres, free tier; PLAN §7.3) ---
# postgres://… connection string from your Neon project.
DATABASE_URL=

# --- Chain RPC (Monad testnet 10143; research D10 priority) ---
# ALCHEMY_RPC_URL wins if set (bounty touchpoint), else RPC_URL, else the
# published KITE_DEPLOYMENT.rpcUrl.
ALCHEMY_RPC_URL=
RPC_URL=https://testnet-rpc.monad.xyz

# --- Signer keys (env-only, NEVER committed — Feature-004 conventions) ---
# RELAYER_KEY holds RELAYER_ROLE ( Monad fees + relayer txs );
# ORCHESTRATOR_KEY holds ORCHESTRATOR_ROLE ( receiveIncome Demo Tool );
# MILL_KEY is channel 1's registered signing address key;
# DEPLOYER_KEY holds MockAUSD for gate funding legs.
RELAYER_KEY=
ORCHESTRATOR_KEY=
MILL_KEY=
DEPLOYER_KEY=

# --- Service auth (static demo keys, constant-time compared — research D11) ---
# MITA_API_KEY: purchase registry routes. INTERNAL_API_KEY: relayer /jobs.
MITA_API_KEY=
INTERNAL_API_KEY=

# --- Service ports ---
API_PORT=3000
RELAYER_PORT=3001

# --- Feature 006 (T003): base URL of the relayer's /jobs surface. The API's
# verification trigger enqueues bind_identity + drip here, server-side only.
RELAYER_URL=http://localhost:3001

# --- Relayer caps (integer wei; research D5/D13) ---
# One-time MON drip amount per wallet (FR-017)…
DRIP_MON_WEI=50000000000000000
# …and the daily cap on relayer native outflow.
RELAYER_DAILY_CAP_MON_WEI=2000000000000000000
