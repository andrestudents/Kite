{
  "name": "kite",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build && forge build --root contracts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "health": "bun scripts/healthcheck.ts",
    "test": "bun test",
    "db:push": "drizzle-kit push --dialect postgresql --schema ./packages/core/src/db/schema.ts --out ./packages/core/drizzle --url \"$DATABASE_URL\" && bun scripts/stamp-recon-baseline.ts",
    "dev:api": "cd apps/api && bun run dev",
    "dev:relayer": "cd apps/relayer && bun run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "turbo": "^2.5.34"
  }
}
