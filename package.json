{
  "name": "kite",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build && forge build --root contracts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "health": "bun scripts/healthcheck.ts",
    "test": "bun test packages apps scripts",
    "db:push": "bun scripts/db-push.ts",
    "dev:api": "cd apps/api && bun run dev",
    "dev:relayer": "cd apps/relayer && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "demo:prep": "bun scripts/demo/prep-serve.ts",
    "no-seed-paths": "bash scripts/gates/no-seed-paths.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@kite/contracts": "workspace:*",
    "@kite/core": "workspace:*",
    "@neondatabase/serverless": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.44.0",
    "turbo": "^2.5.34",
    "viem": "^2.37.0"
  }
}
